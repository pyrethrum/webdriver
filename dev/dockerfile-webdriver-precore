FROM ghcr.io/pyrethrum/haskell:latest

# Build from repo root:
#   docker build --tag ghcr.io/pyrethrum/webdriver-precore:latest --file dev/dockerfile-webdriver-precore ..

# vscode user created in haskell image
ENV DEBIAN_FRONTEND=noninteractive \
    USERNAME=vscode \
    USER_UID=1001 \
    USER_GID=1001

WORKDIR /home/vscode/webdriver

# Copy the entire repo source (context must be the repo root)
COPY --chown=${USER_UID}:${USER_GID} . .

USER ${USER_UID}:${USER_GID}

# Pre-build all dependencies so downstream builds are fast
RUN cabal update \
    && cabal build all --only-dependencies \
    # Clean up cabal cache to reduce image size (keep compiled libraries!)
    && rm -rf /home/vscode/.cabal/packages/*/*/build-reports \
    && rm -rf /home/vscode/.cabal/logs \
    && find /home/vscode/.cabal/packages -name "*.tar.gz" -delete \
    && find /home/vscode/.cabal/store -type f -name "*.p_o" -delete \
    && find /home/vscode/.cabal/store -type f -name "*.p_hi" -delete

CMD ["bash"]