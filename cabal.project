import: https://www.stackage.org/nightly-2026-07-12/cabal.config
  --  https://www.stackage.org/nightly-2025-02-25/cabal.config

-- Allow newer versions to resolve dependency conflicts
allow-newer:
  falsify:optparse-applicative,
  dhall:http-client-tls,
  webdriver-precore

-- Override Stackage constraint to use local development version
constraints: webdriver-precore ==0.3.0.2
  

packages: 
  webdriver-precore/*.cabal
  webdriver-precore/test-server/*.cabal

with-compiler: ghc-9.10.1
-- with-compiler: ghc-9.10.1
-- with-compiler: ghc-9.8.4

-- always build tests without needing the --enable-tests flag
tests: True

-- allow cabal repl to load multiple packages at once
multi-repl: True