    base64        >=0.4   && <1.1,
    bytestring    >=0.10  && <0.12.3,
    dhall         >=1.40  && <1.43,
    directory     >=1.3   && <1.4,
    filepath      >=1.5   && <1.6,
    req           >=3.9   && <3.14,
    tasty-hunit   >=0.10  && <0.11,
    time          >=1.9   && <1.16,
    unliftio      >=0.2   && <0.3
  default-language: Haskell2010

library webdriver-precore-http-runner
  import: commonExtensions, commonGhcOptions, libDepends
  exposed-modules:
      WebDriverPreCore.HttpRunner
